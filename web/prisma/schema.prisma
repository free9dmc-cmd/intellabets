generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id                 String    @id @default(cuid())
  email              String    @unique
  username           String    @unique
  name               String
  image              String?
  password           String
  isPremium          Boolean   @default(false)
  premiumSince       DateTime?
  premiumUntil       DateTime?
  stripeCustomerId   String?
  stripeAccountId    String?
  // Stripe subscription backing the Premium membership. Needed to extend
  // premiumUntil on renewal and to revoke premium when the sub is cancelled.
  premiumStripeSubId String?
  // Provider-neutral backing for the Premium membership once a processor other
  // than Stripe is used (Authorize.Net ARB, NOWPayments, self-custody web3).
  // Additive to premiumStripeSubId so existing Stripe records are untouched.
  // `premiumProvider` is a PaymentProvider id ('authorizenet'|'nowpayments'|'web3');
  // `premiumProviderSubId` is that provider's subscription id (ARB subscriptionId),
  // or null for the per-period rails (crypto/web3) which have no recurring object.
  premiumProvider      String?
  premiumProviderSubId String?
  // Stripe Connect payout onboarding state
  payoutsEnabled     Boolean   @default(false)
  bio                String?
  specialties        String? // comma-separated sports e.g. "NFL,NBA,MLB"
  subscriptionPrice  Float     @default(9.99)
  // Where this user actually bets, so guidance defaults to their own book.
  preferredBook      String?
  totalWins          Int       @default(0)
  totalLosses        Int       @default(0)
  totalPushes        Int       @default(0)
  winRate            Float     @default(0)
  roi                Float     @default(0)
  totalEarnings      Float     @default(0)
  subscriberCount    Int       @default(0)
  isVerified         Boolean   @default(false)
  createdAt          DateTime  @default(now())
  updatedAt          DateTime  @updatedAt

  betslips                  Betslip[]
  subscriptionsAsSubscriber Subscription[]       @relation("Subscriber")
  subscriptionsAsTipster    Subscription[]       @relation("Tipster")
  payouts                   Payout[]
  supportTickets            SupportTicket[]
  placedBets                PlacedBet[]
  passwordResetTokens       PasswordResetToken[]
  aiSubscription            AISubscription?
}

model Betslip {
  id              String    @id @default(cuid())
  userId          String
  user            User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  title           String
  description     String?
  sport           String
  league          String?
  totalOdds       Float     @default(0)
  stake           Float     @default(100)
  potentialReturn Float     @default(0)
  isPublic        Boolean   @default(false)
  isAI            Boolean   @default(false)
  status          String    @default("pending")
  profitLoss      Float     @default(0)
  createdAt       DateTime  @default(now())
  settledAt       DateTime?
  updatedAt       DateTime  @updatedAt

  bets Bet[]
}

model Bet {
  id        String  @id @default(cuid())
  betslipId String
  betslip   Betslip @relation(fields: [betslipId], references: [id], onDelete: Cascade)
  game      String
  homeTeam  String?
  awayTeam  String?
  pick      String
  odds      Float
  betType   String
  line      String?
  sport     String
  gameDate  String?
  result    String?
}

model Subscription {
  id           String   @id @default(cuid())
  subscriberId String
  subscriber   User     @relation("Subscriber", fields: [subscriberId], references: [id], onDelete: Cascade)
  tipsterId    String
  tipster      User     @relation("Tipster", fields: [tipsterId], references: [id], onDelete: Cascade)
  price        Float
  status       String   @default("active")
  stripeSubId  String?
  createdAt    DateTime @default(now())
  expiresAt    DateTime
  updatedAt    DateTime @updatedAt

  @@unique([subscriberId, tipsterId])
}

model AISubscription {
  id          String   @id @default(cuid())
  userId      String   @unique
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  status      String   @default("active")
  stripeSubId String?
  // Provider-neutral backing (additive to stripeSubId). `provider` is the
  // PaymentProvider id; `providerSubId` is the ARB subscriptionId for card, or
  // null for per-period crypto/web3 grants.
  provider     String?
  providerSubId String?
  createdAt   DateTime @default(now())
  expiresAt   DateTime
}

model Payout {
  id        String    @id @default(cuid())
  userId    String
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  amount    Float
  fee       Float
  netAmount Float
  period    String
  status    String    @default("pending")
  createdAt DateTime  @default(now())
  paidAt    DateTime?
}

// ─── Support ─────────────────────────────────────────────────────────────────

model SupportTicket {
  id          String    @id @default(cuid())
  userId      String?
  user        User?     @relation(fields: [userId], references: [id], onDelete: SetNull)
  subject     String
  category    String    @default("other") // billing | access | payout | technical | other
  priority    String    @default("normal") // low | normal | high | urgent
  status      String    @default("open") // open | resolved | closed
  // What the agent could see about the account when it escalated. This is the
  // whole point of escalation: whoever picks the ticket up shouldn't have to
  // re-interrogate the customer to find out what state they were in.
  diagnostics Json?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  resolvedAt  DateTime?

  messages SupportMessage[]

  @@index([status, createdAt])
  @@index([userId])
}

model SupportMessage {
  id        String        @id @default(cuid())
  ticketId  String
  ticket    SupportTicket @relation(fields: [ticketId], references: [id], onDelete: Cascade)
  role      String // user | assistant | staff
  content   String
  createdAt DateTime      @default(now())

  @@index([ticketId, createdAt])
}

// ─── Bet tracking ────────────────────────────────────────────────────────────

// A bet the user actually placed at their own sportsbook.
//
// IntellaBets never places bets — this records what the user says they did, so
// their real results can be tracked against what was recommended.
//
// `source` and `externalId` exist so an automatic feed (e.g. a bet-tracking
// vendor that reads a linked sportsbook account) can populate the same table
// later without a schema change; `externalId` is the dedupe key for that.
model PlacedBet {
  id     String @id @default(cuid())
  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  // The engine pick this came from, if any. Grading follows this pick's result.
  predictionId    String?
  matchup         String
  sport           String
  book            String
  selection       String
  marketType      String
  oddsDecimal     Float
  oddsAmerican    String
  stake           Float
  potentialPayout Float

  status       String    @default("pending") // pending | won | lost | push | void
  actualPayout Float?
  profit       Float?
  settledAt    DateTime?

  source     String  @default("manual") // manual | linked-account
  externalId String?

  placedAt  DateTime @default(now())
  createdAt DateTime @default(now())

  @@unique([userId, externalId])
  @@index([userId, status])
  @@index([predictionId])
}

// ─── Payments: idempotency & orders ──────────────────────────────────────────

// Every processor webhook / on-chain confirmation we have already applied.
//
// Money-path events arrive more than once by design: payment processors retry
// webhooks until they get a 2xx, and a user can POST the same settled tx hash
// twice. Granting entitlements is NOT naturally idempotent (a per-period crypto
// payment adds +1 month each time it runs), so we claim each event here with a
// unique insert BEFORE applying it. A duplicate insert fails on the
// @@unique([provider, eventId]) constraint (Prisma P2002), and we skip.
model ProcessedEvent {
  id          String   @id @default(cuid())
  provider    String // 'nowpayments' | 'authorizenet' | 'web3' | ...
  eventId     String // provider event id, or the tx hash for web3
  type        String?
  processedAt DateTime @default(now())

  @@unique([provider, eventId])
  @@index([processedAt])
}

// A pending payment the server created before handing the user off to a
// processor or an on-chain transfer. It pins down exactly what we expect to be
// paid, so a webhook / tx confirmation can be correlated back to a user + plan
// WITHOUT trusting anything the client sends.
//
// Used by:
//   - NOWPayments: order id passed as `order_id`; the IPN maps back to this row.
//   - web3 (USDC on Base): the confirm route checks the on-chain Transfer
//     against expectedAmount / recipient / tokenAddress / (optional) fromAddress.
//   - Authorize.Net: order id passed as the hosted-payment invoiceNumber.
model PaymentOrder {
  id             String    @id @default(cuid())
  provider       String
  plan           String // PlanId: 'premium' | 'ai'
  userId         String
  // Expected amount in the smallest unit the rail settles in:
  //   fiat rails (NOWPayments / Authorize.Net) -> cents (USD)
  //   web3 (USDC)                               -> base units (6 decimals)
  // Stored as String so large web3 base-unit values never lose precision.
  expectedAmount String
  currency       String    @default("usd")
  // Authorize.Net: the EXACT invoiceNumber (<=20 chars) we sent to the hosted
  // page, stored so the authcapture webhook can match the order back EXACTLY
  // rather than by an id prefix (which could match more than one order).
  // Null for other rails. Additive — existing rows keep null.
  invoiceNumber  String?
  // web3 binding fields (null for fiat rails)
  chainId        Int?
  tokenAddress   String?
  recipient      String?
  // The user's connected wallet, lowercased, if they supplied one at checkout.
  // OPTIONAL extra defense only: when present we also require the on-chain
  // Transfer's `from` to match it. It is client-supplied, so it is NOT the
  // security boundary — the per-order unique `expectedAmount` + exact match is.
  fromAddress    String?
  status         String    @default("pending") // pending | paid | expired
  txHash         String? // web3: the settling transaction
  createdAt      DateTime  @default(now())
  paidAt         DateTime?

  @@index([provider, status])
  @@index([userId])
  @@index([invoiceNumber])
  // Defense-in-depth: one settled transaction can never settle two orders.
  // txHash is null until confirmed; Postgres treats NULLs as distinct, so many
  // pending orders coexist — only non-null (settled) hashes must be unique.
  @@unique([txHash])
}

// ─── Rate limiting ───────────────────────────────────────────────────────────

// A fixed-window counter shared by every serverless instance.
//
// The in-memory limiter this replaces did not work in production: each Vercel
// instance kept its own counter and started from zero on a cold start, so
// seven requests against a limit of five all passed. Verified against the live
// site. Anything protecting spend has to be durable and shared, and Postgres
// is already here -- no extra service to provision or pay for.
model RateLimit {
  key     String   @id
  count   Int      @default(1)
  resetAt DateTime

  @@index([resetAt])
}

// ─── Password reset ──────────────────────────────────────────────────────────

// A single-use, short-lived password reset grant.
//
// Only the SHA-256 of the token is stored. The token itself exists in exactly
// two places: the email we send, and the link in the user's hands. A database
// dump therefore does not let anyone reset an account -- which matters more
// here than usual, since the whole point of this row is to bypass the password.
model PasswordResetToken {
  id        String    @id @default(cuid())
  userId    String
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  tokenHash String    @unique
  expiresAt DateTime
  // Set the moment the token is spent. Presence of this means "already used",
  // which is checked separately from expiry so a replayed link can be told
  // apart from a stale one.
  usedAt    DateTime?
  createdAt DateTime  @default(now())

  @@index([userId])
  @@index([expiresAt])
}
