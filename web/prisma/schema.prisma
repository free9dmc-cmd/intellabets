generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id                 String    @id @default(cuid())
  email              String    @unique
  username           String    @unique
  name               String
  image              String?
  password           String
  isPremium          Boolean   @default(false)
  premiumSince       DateTime?
  premiumUntil       DateTime?
  stripeCustomerId   String?
  stripeAccountId    String?
  // Stripe subscription backing the Premium membership. Needed to extend
  // premiumUntil on renewal and to revoke premium when the sub is cancelled.
  premiumStripeSubId String?
  // Stripe Connect payout onboarding state
  payoutsEnabled     Boolean   @default(false)
  bio                String?
  specialties        String? // comma-separated sports e.g. "NFL,NBA,MLB"
  subscriptionPrice  Float     @default(9.99)
  // Where this user actually bets, so guidance defaults to their own book.
  preferredBook      String?
  totalWins          Int       @default(0)
  totalLosses        Int       @default(0)
  totalPushes        Int       @default(0)
  winRate            Float     @default(0)
  roi                Float     @default(0)
  totalEarnings      Float     @default(0)
  subscriberCount    Int       @default(0)
  isVerified         Boolean   @default(false)
  createdAt          DateTime  @default(now())
  updatedAt          DateTime  @updatedAt

  betslips                  Betslip[]
  subscriptionsAsSubscriber Subscription[]  @relation("Subscriber")
  subscriptionsAsTipster    Subscription[]  @relation("Tipster")
  payouts                   Payout[]
  supportTickets            SupportTicket[]
  placedBets                PlacedBet[]
  aiSubscription            AISubscription?
}

model Betslip {
  id              String    @id @default(cuid())
  userId          String
  user            User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  title           String
  description     String?
  sport           String
  league          String?
  totalOdds       Float     @default(0)
  stake           Float     @default(100)
  potentialReturn Float     @default(0)
  isPublic        Boolean   @default(false)
  isAI            Boolean   @default(false)
  status          String    @default("pending")
  profitLoss      Float     @default(0)
  createdAt       DateTime  @default(now())
  settledAt       DateTime?
  updatedAt       DateTime  @updatedAt

  bets Bet[]
}

model Bet {
  id        String  @id @default(cuid())
  betslipId String
  betslip   Betslip @relation(fields: [betslipId], references: [id], onDelete: Cascade)
  game      String
  homeTeam  String?
  awayTeam  String?
  pick      String
  odds      Float
  betType   String
  line      String?
  sport     String
  gameDate  String?
  result    String?
}

model Subscription {
  id           String   @id @default(cuid())
  subscriberId String
  subscriber   User     @relation("Subscriber", fields: [subscriberId], references: [id], onDelete: Cascade)
  tipsterId    String
  tipster      User     @relation("Tipster", fields: [tipsterId], references: [id], onDelete: Cascade)
  price        Float
  status       String   @default("active")
  stripeSubId  String?
  createdAt    DateTime @default(now())
  expiresAt    DateTime
  updatedAt    DateTime @updatedAt

  @@unique([subscriberId, tipsterId])
}

model AISubscription {
  id          String   @id @default(cuid())
  userId      String   @unique
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  status      String   @default("active")
  stripeSubId String?
  createdAt   DateTime @default(now())
  expiresAt   DateTime
}

model Payout {
  id        String    @id @default(cuid())
  userId    String
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  amount    Float
  fee       Float
  netAmount Float
  period    String
  status    String    @default("pending")
  createdAt DateTime  @default(now())
  paidAt    DateTime?
}

// ─── Support ─────────────────────────────────────────────────────────────────

model SupportTicket {
  id          String    @id @default(cuid())
  userId      String?
  user        User?     @relation(fields: [userId], references: [id], onDelete: SetNull)
  subject     String
  category    String    @default("other") // billing | access | payout | technical | other
  priority    String    @default("normal") // low | normal | high | urgent
  status      String    @default("open") // open | resolved | closed
  // What the agent could see about the account when it escalated. This is the
  // whole point of escalation: whoever picks the ticket up shouldn't have to
  // re-interrogate the customer to find out what state they were in.
  diagnostics Json?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  resolvedAt  DateTime?

  messages SupportMessage[]

  @@index([status, createdAt])
  @@index([userId])
}

model SupportMessage {
  id        String        @id @default(cuid())
  ticketId  String
  ticket    SupportTicket @relation(fields: [ticketId], references: [id], onDelete: Cascade)
  role      String // user | assistant | staff
  content   String
  createdAt DateTime      @default(now())

  @@index([ticketId, createdAt])
}

// ─── Bet tracking ────────────────────────────────────────────────────────────

// A bet the user actually placed at their own sportsbook.
//
// IntellaBets never places bets — this records what the user says they did, so
// their real results can be tracked against what was recommended.
//
// `source` and `externalId` exist so an automatic feed (e.g. a bet-tracking
// vendor that reads a linked sportsbook account) can populate the same table
// later without a schema change; `externalId` is the dedupe key for that.
model PlacedBet {
  id     String @id @default(cuid())
  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  // The engine pick this came from, if any. Grading follows this pick's result.
  predictionId    String?
  matchup         String
  sport           String
  book            String
  selection       String
  marketType      String
  oddsDecimal     Float
  oddsAmerican    String
  stake           Float
  potentialPayout Float

  status       String    @default("pending") // pending | won | lost | push | void
  actualPayout Float?
  profit       Float?
  settledAt    DateTime?

  source     String  @default("manual") // manual | linked-account
  externalId String?

  placedAt  DateTime @default(now())
  createdAt DateTime @default(now())

  @@unique([userId, externalId])
  @@index([userId, status])
  @@index([predictionId])
}

// ─── Rate limiting ───────────────────────────────────────────────────────────

// A fixed-window counter shared by every serverless instance.
//
// The in-memory limiter this replaces did not work in production: each Vercel
// instance kept its own counter and started from zero on a cold start, so
// seven requests against a limit of five all passed. Verified against the live
// site. Anything protecting spend has to be durable and shared, and Postgres
// is already here -- no extra service to provision or pay for.
model RateLimit {
  key     String   @id
  count   Int      @default(1)
  resetAt DateTime

  @@index([resetAt])
}
