# ─── Database (Neon / any Postgres) ──────────────────────────────────────────
DATABASE_URL="postgresql://user:password@host/dbname?sslmode=require"

# ─── NextAuth ────────────────────────────────────────────────────────────────
# Generate the secret with: openssl rand -base64 32
NEXTAUTH_SECRET="change-me-in-production"
NEXTAUTH_URL="http://localhost:3000"

# ─── App ─────────────────────────────────────────────────────────────────────
NEXT_PUBLIC_APP_URL="http://localhost:3000"
ADMIN_EMAILS="you@yourdomain.com"

# ─── Anthropic (powers AI picks) ─────────────────────────────────────────────
ANTHROPIC_API_KEY="sk-ant-..."

# ─── Stripe (web payments) ───────────────────────────────────────────────────
# Leave these unset to run in demo mode (instant activation, no real charges).
# NOTE: STRIPE_PUBLISHABLE_KEY is NOT used — checkout is a server-side redirect
# to Stripe-hosted checkout, so only the secret key is required.
STRIPE_SECRET_KEY="sk_test_..."
# From Stripe -> Developers -> Webhooks, endpoint /api/webhooks/stripe
STRIPE_WEBHOOK_SECRET="whsec_..."

# ─── RevenueCat (mobile IAP webhooks) ────────────────────────────────────────
REVENUECAT_WEBHOOK_SECRET="your-revenuecat-webhook-secret"
NEXT_PUBLIC_REVENUECAT_IOS_KEY="appl_..."
NEXT_PUBLIC_REVENUECAT_ANDROID_KEY="goog_..."
