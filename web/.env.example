# ─── Database (Neon / any Postgres) ──────────────────────────────────────────
DATABASE_URL="postgresql://user:password@host/dbname?sslmode=require"

# ─── NextAuth ────────────────────────────────────────────────────────────────
# Generate the secret with: openssl rand -base64 32
NEXTAUTH_SECRET="change-me-in-production"
NEXTAUTH_URL="http://localhost:3000"

# ─── App ─────────────────────────────────────────────────────────────────────
NEXT_PUBLIC_APP_URL="http://localhost:3000"
ADMIN_EMAILS="you@yourdomain.com"

# ─── Anthropic (powers AI picks) ─────────────────────────────────────────────
ANTHROPIC_API_KEY="sk-ant-..."

# ─── Stripe (web payments) ───────────────────────────────────────────────────
# NOTE: STRIPE_PUBLISHABLE_KEY is NOT used. Checkout is a server-side redirect
# to Stripe-hosted checkout, so only the secret key is required.
STRIPE_SECRET_KEY="sk_test_..."
# From Stripe -> Developers -> Webhooks, endpoint /api/webhooks/stripe
STRIPE_WEBHOOK_SECRET="whsec_..."

# ─── Local demo billing — NEVER set this in production ───────────────────────
# Enables the mock activation endpoints (POST /api/premium,
# POST /api/subscriptions) which grant paid entitlements with NO payment.
# Force-disabled whenever NODE_ENV=production, regardless of this value.
# Leave unset unless you are developing locally without Stripe keys.
# DEMO_BILLING="true"

# ─── RevenueCat (mobile IAP webhooks) ────────────────────────────────────────
REVENUECAT_WEBHOOK_SECRET="your-revenuecat-webhook-secret"
NEXT_PUBLIC_REVENUECAT_IOS_KEY="appl_..."
NEXT_PUBLIC_REVENUECAT_ANDROID_KEY="goog_..."

# ─── Prediction engine (the NestJS API) ──────────────────────────────────────
# The engine has its own user table, so the web app authenticates its OWN user
# and then calls the engine server-to-server with this key. SERVER-SIDE ONLY —
# never expose it to the browser (no NEXT_PUBLIC_ prefix).
# Must match ENGINE_SERVICE_KEY on the backend. Generate: openssl rand -hex 32
ENGINE_API_URL="https://api.intellabets.com/api/v1"
ENGINE_SERVICE_KEY=""
