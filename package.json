{
  "name": "intellabets",
  "version": "1.0.0",
  "private": true,
  "workspaces": [
    "backend",
    "web",
    "admin-web",
    "packages/*"
  ],
  "scripts": {
    "dev:backend": "npm run dev --workspace=backend",
    "dev:web": "npm run dev --workspace=@intellabets/web",
    "dev:admin": "npm run dev --workspace=admin-web",
    "build:backend": "npm run build --workspace=backend",
    "build:web": "npm run build --workspace=@intellabets/web",
    "build:admin": "npm run build --workspace=admin-web",
    "db:push": "npm run db:push --workspace=backend",
    "db:seed": "npm run db:seed --workspace=backend",
    "db:studio": "npm run db:studio --workspace=backend",
    "lint": "npm run lint --workspaces --if-present",
    "typecheck": "npm run typecheck --workspaces --if-present"
  },
  "devDependencies": {
    "prettier": "^3.3.0",
    "typescript": "^5.5.0"
  },
  "engines": {
    "node": ">=22.12.0"
  },
  "overrides": {
    "authorizenet": {
      "axios": "^1.20.0"
    },
    "viem": {
      "ws": "^8.22.0"
    },
    "next": {
      "postcss": "^8.5.31"
    },
    "@nestjs/platform-express": {
      "multer": "^2.5.0"
    },
    "@nestjs/swagger": {
      "js-yaml": "^5.5.0"
    },
    "bull": {
      "uuid": "^11.1.1"
    },
    "valtio": {
      "use-sync-external-store": "^1.4.0"
    },
    "@reown/appkit-adapter-wagmi": {
      "@wagmi/connectors": "^6.2.0"
    },
    "@metamask/utils": {
      "uuid": "^11.1.1"
    },
    "@metamask/sdk": {
      "uuid": "^11.1.1"
    },
    "@metamask/sdk-communication-layer": {
      "uuid": "^11.1.1"
    },
    "tailwindcss": {
      "postcss-selector-parser": "^7.1.7"
    },
    "@walletconnect/ethereum-provider": "2.26.0",
    "@typescript-eslint/typescript-estree": {
      "minimatch": "^11.0.5"
    },
    "rimraf": {
      "glob": "^14.0.4"
    },
    "@nestjs/cli": {
      "glob": "^14.0.4"
    }
  }
}
