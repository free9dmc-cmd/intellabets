# Development placeholders for the Base44 sandbox (docker-compose.base44.yml).
#
# This file exists so the stack boots with no credentials at all. Nothing in it
# is a real credential and it is never read in production — production config
# lives in render.yaml (API) and Vercel (web).
#
# Anything the user owns (THE_ODDS_API_KEY, ANTHROPIC_API_KEY, RESEND_API_KEY,
# payment keys) is delivered by the platform to /run/base44/app.env, which
# compose reads AFTER this file: a real value always overrides the placeholder.
# Never move a user-supplied credential in here — a value in a committed file or
# in compose `environment:` outranks the platform's copy permanently, so a later
# dashboard update would silently do nothing.

# ─── Signing keys (local development values) ─────────────────────────────────
# next-auth v4 and the engine's JwtModule both fall back to a shared "dev-secret"
# constant in code; these keep web and API on one known local value instead.
NEXTAUTH_SECRET=base44-sandbox-nextauth-secret-not-for-production
JWT_SECRET=base44-sandbox-jwt-secret-not-for-production

# ─── Service-to-service key ──────────────────────────────────────────────────
# MUST be identical for the web app and the engine, or the picks pages load
# empty with no error (see README). Both services read this same file.
# web/lib/engine.ts requires at least 16 characters.
ENGINE_SERVICE_KEY=base44-sandbox-engine-service-key-0123456789

# ─── Local operator access ───────────────────────────────────────────────────
# Whoever is listed here gets the /admin console. demo@intellabets.com is the
# seeded demo account so the console is reachable in the preview; drop it for
# any environment that is not a sandbox.
ADMIN_EMAILS=admin@intellabets.com,demo@intellabets.com

# ─── Engine ingestion ────────────────────────────────────────────────────────
# Only used once THE_ODDS_API_KEY is set; the engine needs games to find edges
# in, so nothing appears on the picks pages until then. Same sport list and
# cadence as render.yaml — each sport costs API requests on every poll cycle.
ACTIVE_SPORTS=americanfootball_nfl,americanfootball_ncaaf,basketball_nba,icehockey_nhl,baseball_mlb
POLL_INTERVAL_MIN=30
SETTLE_INTERVAL_MIN=60
