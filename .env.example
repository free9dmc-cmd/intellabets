# ─── Database ────────────────────────────────────────────────────────────────
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/intellabets"

# ─── Redis ───────────────────────────────────────────────────────────────────
REDIS_URL="redis://localhost:6379"

# ─── Auth ────────────────────────────────────────────────────────────────────
JWT_SECRET="change-me-in-production-openssl-rand-base64-32"
JWT_EXPIRES_IN="7d"
JWT_REFRESH_EXPIRES_IN="30d"

# ─── Anthropic AI ────────────────────────────────────────────────────────────
ANTHROPIC_API_KEY="sk-ant-..."

# ─── RevenueCat (iOS/Android IAP) ────────────────────────────────────────────
REVENUECAT_WEBHOOK_SECRET="your-revenuecat-webhook-secret"
NEXT_PUBLIC_REVENUECAT_IOS_KEY="appl_..."
NEXT_PUBLIC_REVENUECAT_ANDROID_KEY="goog_..."

# ─── Payments: processor-agnostic billing rails (web) ────────────────────────
# Every rail is DORMANT until its keys are present: with none set, web checkout
# degrades to a clean 503. Pick the default rail with BILLING_PROVIDER
# (authorizenet | nowpayments | web3); unset defaults to card (Authorize.Net).
BILLING_PROVIDER="authorizenet"

# CARD — Authorize.Net (the gateway behind "2Accept"). The Signature Key is
# DISTINCT from the Transaction Key and is what webhooks are signed with.
AUTHNET_API_LOGIN_ID=""
AUTHNET_TRANSACTION_KEY=""
AUTHNET_SIGNATURE_KEY=""
AUTHNET_ENV="sandbox"            # "production" for live; anything else = sandbox

# CUSTODIAL CRYPTO — NOWPayments. IPN secret is used to verify the x-nowpayments-sig
# HMAC on callbacks (distinct from the API key).
NOWPAYMENTS_API_KEY=""
NOWPAYMENTS_IPN_SECRET=""
NOWPAYMENTS_SANDBOX="true"       # "true" uses api-sandbox.nowpayments.io

# SELF-CUSTODY WEB3 — USDC on Base, verified by tx hash (no smart contract).
WEB3_RECEIVING_ADDRESS=""        # single address that receives USDC payments
WEB3_RPC_URL=""                  # server-side Base RPC used to verify transactions
WEB3_CONFIRMATIONS="3"           # confirmations required before crediting a payment
WEB3_SANDBOX="false"             # "true" targets Base Sepolia (testnet)

# Public (browser) web3 config — safe to expose.
NEXT_PUBLIC_WALLETCONNECT_PROJECT_ID=""   # Reown Cloud / WalletConnect project id
NEXT_PUBLIC_WEB3_RPC_URL=""               # Base RPC the wallet UI uses
NEXT_PUBLIC_WEB3_SANDBOX="false"          # must match WEB3_SANDBOX
NEXT_PUBLIC_APP_URL="http://localhost:3000"  # used to build webhook/return URLs

# ─── Sportsbook / Odds APIs ──────────────────────────────────────────────────
THE_ODDS_API_KEY="..."          # theoddsapi.com — multi-book odds (powers consensus)
SPORTRADAR_API_KEY="..."        # sportradar.com — live streaming odds (optional)

# ─── Prediction engine tuning ────────────────────────────────────────────────
AI_MODEL="claude-sonnet-4-6"    # analyst model for filtering value bets
MIN_EDGE_PERCENT="2"            # minimum EV% to surface a bet
KELLY_FRACTION="0.25"           # fractional Kelly for stake sizing
MIN_BOOKS="3"                   # min bookmakers required to trust consensus

# ─── Ingestion scheduler ─────────────────────────────────────────────────────
POLL_INTERVAL_MIN="15"          # how often to poll odds per sport
SETTLE_INTERVAL_MIN="30"        # how often to grade finished games
DISABLE_INGESTION="false"       # set true to stop the background scheduler
PROVIDER_LATENCY_THRESHOLD_MS="3000"

# ─── Encryption (for sportsbook auth token storage) ──────────────────────────
ENCRYPTION_KEY="32-byte-hex-key-openssl-rand-hex-32"
ENCRYPTION_IV="16-byte-hex-iv-openssl-rand-hex-16"

# ─── App ─────────────────────────────────────────────────────────────────────
APP_URL="http://localhost:3000"
API_URL="http://localhost:4000"
ADMIN_WEB_URL="http://localhost:3001"
PLATFORM_FEE_PERCENT="20"
ADMIN_EMAILS="admin@intellabets.com"

# ─── Push Notifications (real-time odds / pick alerts) ───────────────────────
PUSHER_APP_ID="..."
PUSHER_KEY="..."
PUSHER_SECRET="..."
PUSHER_CLUSTER="us2"
NEXT_PUBLIC_PUSHER_KEY="..."
NEXT_PUBLIC_PUSHER_CLUSTER="us2"

# ─── Service-to-service auth ─────────────────────────────────────────────────
# Lets the consumer web app read engine picks on behalf of its own premium
# users. Must match ENGINE_SERVICE_KEY in the web app. Generate: openssl rand -hex 32
ENGINE_SERVICE_KEY=""
