# dependencies
# No leading slash: this is a workspace monorepo, so each package can have its
# own node_modules alongside the hoisted one at the root.
node_modules/
.pnp
.pnp.js

# testing
coverage/

# build output
.next/
out/
build/
dist/
*.tsbuildinfo
next-env.d.ts

# env files — never commit real credentials
.env
.env.*
!.env.example

# database
*.db
*.db-journal

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# native mobile shells (generated by `cap add`)
web/ios/
web/android/

# misc
.DS_Store
*.pem
.vercel
